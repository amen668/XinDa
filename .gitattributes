# Normalize all text to LF in the repo (working tree had CRLF churn on the
# Windows/WSL boundary). `text=auto` stores LF; binaries are left untouched.
* text=auto

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.tbx binary
*.ckpt binary

# Stable bytes for published checksums on Windows and Linux.
examples/audit/** text eol=lf
examples/corpus_manifests/** text eol=lf
examples/results/** text eol=lf
research/** -text whitespace=cr-at-eol
